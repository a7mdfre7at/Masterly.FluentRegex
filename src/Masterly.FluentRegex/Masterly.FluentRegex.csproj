<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Ahmad Al-Freihat</Authors>
    <Description>A fluent, immutable API for building, analyzing, testing and visualizing .NET regular expressions. Includes typed extraction, regex-to-fluent conversion, sample generation, ReDoS analysis, match tracing, railroad diagrams and a compile-time source generator with analyzers.</Description>
    <PackageProjectUrl>https://github.com/a7mdfre7at/Masterly.FluentRegex</PackageProjectUrl>
    <RepositoryUrl>https://github.com/a7mdfre7at/Masterly.FluentRegex</RepositoryUrl>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageIcon>repo_image.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Regex;Fluent;FluentRegex;FluentAPI;Regular;Expression;Pattern;ReDoS;SourceGenerator;Railroad;Testing</PackageTags>
    <PackageReleaseNotes>See https://github.com/a7mdfre7at/Masterly.FluentRegex/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <AssemblyVersion>3.0.0</AssemblyVersion>
    <FileVersion>3.0.0</FileVersion>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Masterly.FluentRegex.Tests" />
  </ItemGroup>

  <!--
    The source generator, analyzers and code fixes ship inside this package under analyzers/dotnet/cs,
    so installing Masterly.FluentRegex is all it takes to get compile-time checks.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Masterly.FluentRegex.Analyzers\Masterly.FluentRegex.Analyzers.csproj"
                      ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" PrivateAssets="all" />
    <ProjectReference Include="..\Masterly.FluentRegex.CodeFixes\Masterly.FluentRegex.CodeFixes.csproj"
                      ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Masterly.FluentRegex.Analyzers\bin\$(Configuration)\netstandard2.0\Masterly.FluentRegex.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Masterly.FluentRegex.CodeFixes\bin\$(Configuration)\netstandard2.0\Masterly.FluentRegex.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <Visible>False</Visible>
    </None>
    <None Include="..\..\repo_image.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <Visible>False</Visible>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <Visible>False</Visible>
    </None>
    <None Include="..\..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>$(PackageLicenseFile)</PackagePath>
      <Visible>False</Visible>
    </None>
  </ItemGroup>

</Project>
