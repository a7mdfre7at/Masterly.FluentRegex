<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageId>Masterly.FluentRegex.AI</PackageId>
    <Authors>Ahmad Al-Freihat</Authors>
    <Description>Draft Masterly.FluentRegex patterns from plain-language descriptions with Claude, then verify every draft locally: valid .NET syntax, no ReDoS findings, every positive example fully matched and every negative example rejected. Failed checks are fed back to the model and retried. No SDK dependency; AOT and trim safe.</Description>
    <PackageProjectUrl>https://github.com/a7mdfre7at/Masterly.FluentRegex</PackageProjectUrl>
    <RepositoryUrl>https://github.com/a7mdfre7at/Masterly.FluentRegex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>repo_image.png</PackageIcon>
    <PackageTags>Regex;FluentRegex;AI;Claude;Anthropic;LLM;ReDoS;Verification</PackageTags>
    <PackageReleaseNotes>See https://github.com/a7mdfre7at/Masterly.FluentRegex/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <AssemblyVersion>3.1.1</AssemblyVersion>
    <FileVersion>3.1.1</FileVersion>
    <Version>3.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Masterly.FluentRegex.Integrations.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.FluentRegex\Masterly.FluentRegex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="$(PackageLicenseFile)" Visible="false" />
    <None Include="..\..\repo_image.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
