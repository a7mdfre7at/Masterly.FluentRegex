<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Browser playground for Masterly.FluentRegex. Runs the real library in WebAssembly, so every
    panel shows exactly what the package does. Kept out of the solution so library CI stays fast;
    .github/workflows/docs.yml publishes it to GitHub Pages next to the documentation site.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- The library's culture-sensitive parsing needs full ICU data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Masterly.FluentRegex\Masterly.FluentRegex.csproj" />
  </ItemGroup>

</Project>
